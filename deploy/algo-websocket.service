[Unit]
Description=Algo Websocket (primary — owns the broker connection)
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/app/algo-backend/algo.websocket
ExecStart=/app/algo-backend/algo.websocket/venv/bin/python -m uvicorn ws_main:app --host 127.0.0.1 --port 8003
Restart=always

[Install]
WantedBy=multi-user.target
